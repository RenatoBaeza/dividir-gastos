# Supabase -> Project Settings -> Database -> Connection string (URI).
# Either the direct connection or the session pooler works.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DB_ECHO=false

# Supabase -> Project Settings -> API
SUPABASE_URL=https://PROJECT.supabase.co
# Only needed for projects still signing tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated

# Comma-separated exact origins, plus an optional regex for Vercel previews.
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# Forces NullPool + no prepared statements. Auto-detected on Vercel (VERCEL=1);
# only set this by hand on another serverless host.
SERVERLESS=false

# Local-only: accept "Authorization: Dev <email>" instead of a real Supabase token.
# Never enable this on anything reachable from the internet.
AUTH_DEV_MODE=false
