# Which set of safety rules applies: development | test | staging | production.
# On Vercel this self-detects from VERCEL_ENV. In production the app refuses to
# start if anything below is configured unsafely.
ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Either the direct connection or the session pooler works.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DB_ECHO=false

# Connection pool (ignored when running serverless, which uses no pool).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
DB_PROBE_TIMEOUT_SECONDS=3

# Server-side guards so one bad query cannot hold a pooler slot. 0 disables.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Supabase -> Project Settings -> API
SUPABASE_URL=https://PROJECT.supabase.co
# Only needed for projects still signing tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=10
JWKS_TIMEOUT_SECONDS=5

# Comma-separated exact origins, plus an optional regex for Vercel previews.
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=
# Comma-separated Host values to accept. Empty means "any", which is fine behind
# a platform router that already filters by hostname.
TRUSTED_HOSTS=
# Serves /docs, /redoc and /openapi.json. Turn off to keep the schema private.
DOCS_ENABLED=true

# Limits. The rate limiter is per process, so on serverless each warm instance
# enforces its own budget; treat it as a safety net, not a quota.
MAX_REQUEST_BYTES=8000000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_HEAVY_REQUESTS=12
RATE_LIMIT_HEAVY_WINDOW_SECONDS=60

# Logging. JSON lines everywhere except development unless forced either way.
LOG_LEVEL=INFO
LOG_JSON=

# Forces NullPool + no prepared statements. Auto-detected on Vercel (VERCEL=1);
# only set this by hand on another serverless host.
SERVERLESS=false

# Local-only: accept "Authorization: Dev <email>" instead of a real Supabase token.
# Never enable this on anything reachable from the internet; production refuses
# to boot with it on.
AUTH_DEV_MODE=false
